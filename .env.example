# ==============================================
# 1. DATABASE CONNECTIONS (Docker Local)
# ==============================================

# PostgreSQL (Core Game Data & Questions)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logicforge?schema=public"

# MongoDB (Authentication & User Sessions) – used by apps/web and packages/db
# Format: mongodb://USER:PASSWORD@HOST:PORT/DB_NAME?authSource=admin
MONGO_URL="mongodb://admin:password@localhost:27017/logicforge_auth?authSource=admin"

# Redis (Caching & Real-time Pub/Sub)
REDIS_URL="redis://localhost:6379"

# ==============================================
# 2. NEXT AUTHENTICATION (Auth.js)
# ==============================================

# The URL of your web application
NEXTAUTH_URL="http://localhost:3000"

# Secret key for encrypting sessions (Generate one with: openssl rand -base64 32)
NEXTAUTH_SECRET="change_this_to_a_secure_random_string"

# ==============================================
# 3. OAUTH PROVIDERS
# ==============================================

# GitHub OAuth (Get these from GitHub Developer Settings)
GITHUB_ID=""
GITHUB_SECRET=""

# Google OAuth (Get these from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==============================================
# 4. SERVICE CONFIGURATION
# ==============================================

# Environment (development, test, production)
NODE_ENV="development"

# Port Configuration (Optional overrides)
PORT_WEB=3000
PORT_GAME_API=3001
PORT_QUESTION_ENGINE=3002
PORT_ANTI_CHEAT=3003
PORT_CODE_RUNNER=3004

# Service URLs (for inter-service communication)
QUESTION_ENGINE_URL="http://localhost:3002"
CODE_RUNNER_URL="http://localhost:3004"
ANTI_CHEAT_URL="http://localhost:3003"

# Gateway (API entrypoint)
# Public HTTP entry for all backend services (proxied to internal Docker network)
GATEWAY_URL="http://localhost:8080"

# Frontend-facing API/WebSocket URLs (baked at build time; NEXT_PUBLIC_* only)
# Use a single-level subdomain in production (e.g. logicforge-api.saswat.app) so
# Cloudflare free Universal SSL (*.saswat.app) is valid. api.logicforge.saswat.app
# is two levels deep and causes ERR_SSL_VERSION_OR_CIPHER_MISMATCH.
# NEXT_PUBLIC_GAME_API_URL="https://logicforge-api.saswat.app/api/game"
# NEXT_PUBLIC_GAME_WS_URL="https://logicforge-api.saswat.app"
# Optional: base gateway URL (no path). If unset, derived from NEXT_PUBLIC_GAME_API_URL.
# NEXT_PUBLIC_GATEWAY_URL="https://logicforge-api.saswat.app"
# NEXT_PUBLIC_APP_URL="https://logicforge.saswat.app"

# Inter-service auth
INTER_SERVICE_SECRET="dev-inter-service-secret"